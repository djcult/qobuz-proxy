# Raspberry Pi system service template (see README.md).
# Replace @USER@ and @HOME@ before installing; do not run this template as-is.
[Unit]
Description=Qobuz Connect ALSA Proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/src/qobuz-proxy
Environment=PYTHONUNBUFFERED=1
# Shared with qobuz-pi-control; don't enable PrivateTmp=true here.
Environment=QOBUZ_PCM_MONITOR_SOCKET=/tmp/qobuz-pcm.sock
ExecStart=@HOME@/src/qobuz-proxy/.venv/bin/qobuz-proxy --config @HOME@/src/qobuz-proxy/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
